{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "kind": {
      "const": "assets"
    },
    "artifact_id": {
      "type": "string",
      "minLength": 1
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "data": {
      "type": "object",
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "path": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "minLength": 1
              },
              "origin": {
                "type": "string",
                "minLength": 1
              },
              "usage_notes": {
                "type": "string",
                "minLength": 1
              },
              "provenance": {
                "type": "object",
                "properties": {
                  "source_type": {
                    "enum": [
                      "user",
                      "generated",
                      "local",
                      "web",
                      "code"
                    ]
                  },
                  "source_url": {
                    "type": "string"
                  },
                  "license": {
                    "type": "string"
                  },
                  "license_url": {
                    "type": "string"
                  },
                  "creator": {
                    "type": "string"
                  },
                  "generator": {
                    "type": "string"
                  },
                  "prompt": {
                    "type": "string"
                  },
                  "created_at": {
                    "type": "string"
                  }
                },
                "required": [
                  "source_type"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "id",
              "path",
              "sha256",
              "origin",
              "usage_notes"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "items"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "kind",
    "artifact_id",
    "revision",
    "data"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
