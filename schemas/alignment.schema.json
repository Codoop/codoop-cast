{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "kind": {
      "const": "alignment"
    },
    "artifact_id": {
      "type": "string",
      "minLength": 1
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "data": {
      "type": "object",
      "properties": {
        "script": {
          "type": "object",
          "required": [
            "artifact_id",
            "revision"
          ],
          "properties": {
            "artifact_id": {
              "type": "string",
              "minLength": 1
            },
            "revision": {
              "type": "integer",
              "minimum": 1
            }
          },
          "additionalProperties": false
        },
        "audio": {
          "type": "object",
          "required": [
            "artifact_id",
            "revision"
          ],
          "properties": {
            "artifact_id": {
              "type": "string",
              "minLength": 1
            },
            "revision": {
              "type": "integer",
              "minimum": 1
            }
          },
          "additionalProperties": false
        },
        "state": {
          "enum": [
            "pending",
            "ready",
            "needs_review"
          ]
        },
        "timebase": {
          "const": "audio_samples"
        },
        "units": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "script_span": {
                "type": "object",
                "properties": {
                  "paragraph_id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "start": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "end": {
                    "type": "integer",
                    "minimum": 1
                  }
                },
                "required": [
                  "paragraph_id",
                  "start",
                  "end"
                ],
                "additionalProperties": false
              },
              "start_sample": {
                "type": "integer",
                "minimum": 0
              },
              "end_sample": {
                "type": "integer",
                "minimum": 0
              }
            },
            "required": [
              "id",
              "script_span",
              "start_sample",
              "end_sample"
            ],
            "additionalProperties": false
          }
        },
        "cues": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "text": {
                "type": "string",
                "minLength": 1
              },
              "unit_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "start_sample": {
                "type": "integer",
                "minimum": 0
              },
              "end_sample": {
                "type": "integer",
                "minimum": 0
              }
            },
            "required": [
              "id",
              "text",
              "unit_ids",
              "start_sample",
              "end_sample"
            ],
            "additionalProperties": false
          }
        },
        "issues": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "span_basis": {
          "enum": [
            "spoken_text",
            "display_text"
          ]
        }
      },
      "required": [
        "script",
        "audio",
        "state",
        "timebase",
        "units",
        "cues",
        "issues"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "kind",
    "artifact_id",
    "revision",
    "data"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
