{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema_version",
    "kind",
    "stage",
    "version",
    "state",
    "dependencies",
    "files"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "kind": {
      "const": "stage-version"
    },
    "stage": {
      "enum": [
        "research",
        "script",
        "storyboard",
        "assets",
        "voice",
        "subtitles",
        "scenes",
        "exports"
      ]
    },
    "version": {
      "type": "string",
      "pattern": "^v[0-9]{3,}$"
    },
    "state": {
      "enum": [
        "ready",
        "partial"
      ]
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "stage",
          "version",
          "sha256"
        ],
        "additionalProperties": false,
        "properties": {
          "stage": {
            "enum": [
              "research",
              "script",
              "storyboard",
              "assets",
              "voice",
              "subtitles",
              "scenes",
              "exports"
            ]
          },
          "version": {
            "type": "string",
            "pattern": "^v[0-9]{3,}$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    },
    "files": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      }
    }
  }
}
